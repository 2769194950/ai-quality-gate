{
  "name": "ai-quality-gate",
  "private": true,
  "version": "1.0.0",
  "description": "qgate — deterministic quality-gate contract engine (offline, zero runtime dependencies)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node packages/qgate/test/run-all.mjs",
    "test:contract": "node --test --test-concurrency=1 --experimental-test-isolation=none packages/qgate/test/schema-contract.test.mjs",
    "test:all": "node packages/qgate/test/run-all.mjs",
    "check": "node packages/qgate/bin/qgate.mjs check --config demo/qgate.config.json",
    "check:json": "node packages/qgate/bin/qgate.mjs check --config demo/qgate.config.json --json",
    "check:summary": "node packages/qgate/bin/qgate.mjs check --config demo/qgate.config.json --summary",
    "contract": "node packages/qgate/bin/qgate.mjs contract --check",
    "check:root": "node packages/qgate/bin/qgate.mjs check --config qgate.config.json --json",
    "trace": "node packages/qgate/bin/qgate.mjs trace --config demo/qgate.config.json --summary",
    "preview": "node packages/qgate/bin/qgate.mjs preview --root demo/mini-service --config demo/qgate.config.json --summary",
    "report": "node packages/qgate/bin/qgate.mjs report --config demo/qgate.config.json",
    "verify": "node packages/qgate/bin/qgate.mjs check --config demo/qgate.config.json --json",
    "release:check": "node tools/public-release-check.mjs"
  }
}
